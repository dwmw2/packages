From 7938435f7df2f74358700bfd90eda082a4945ec9 Mon Sep 17 00:00:00 2001
From: David Woodhouse <dwmw@amazon.co.uk>
Date: Fri, 30 Oct 2026 22:05:33 +0000
Subject: [PATCH 4/4] ubus: parse umdns browse table with the correct policy
 count

blobmsg_parse() of dawn_umdns_table_policy was passed __DAWN_UMDNS_MAX
(the size of the per-host policy) instead of __DAWN_UMDNS_TABLE_MAX,
reading past the end of the one-entry policy array.

Signed-off-by: David Woodhouse <dwmw@amazon.co.uk>
---
 src/utils/ubus.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/utils/ubus.c b/src/utils/ubus.c
index 93bbc2f..9c77c0f 100644
--- a/src/utils/ubus.c
+++ b/src/utils/ubus.c
@@ -1344,7 +1344,7 @@ static void ubus_umdns_cb(struct ubus_request *req, int type, struct blob_attr *
     if (!msg)
         return;
 
-    blobmsg_parse(dawn_umdns_table_policy, __DAWN_UMDNS_MAX, tb, blob_data(msg), blob_len(msg));
+    blobmsg_parse(dawn_umdns_table_policy, __DAWN_UMDNS_TABLE_MAX, tb, blob_data(msg), blob_len(msg));
 
     if (!tb[DAWN_UMDNS_TABLE]) {
         return;
-- 
2.43.0

